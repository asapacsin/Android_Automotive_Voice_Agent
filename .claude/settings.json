{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(GEMINI_CLI_TRUST_WORKSPACE=true GEMINI_API_KEY=injected-by-proxy gemini:*)"
    ],
    "deny": [
      "Edit(/app/src/**)",
      "Write(/app/src/**)",
      "Edit(/behavior-test/src/**)",
      "Write(/behavior-test/src/**)",
      "Edit(/contracts/src/**)",
      "Write(/contracts/src/**)",
      "Edit(/demo/src/**)",
      "Write(/demo/src/**)",
      "Edit(/evaluation/src/**)",
      "Write(/evaluation/src/**)",
      "Edit(/feedback/src/**)",
      "Write(/feedback/src/**)",
      "Edit(/ingress/src/**)",
      "Write(/ingress/src/**)",
      "Edit(/orchestration/src/**)",
      "Write(/orchestration/src/**)",
      "Edit(/safety/src/**)",
      "Write(/safety/src/**)",
      "Edit(/simulator/src/**)",
      "Write(/simulator/src/**)",
      "Edit(/vehicle/src/**)",
      "Write(/vehicle/src/**)",
      "Edit(/verification/src/**)",
      "Write(/verification/src/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/delegation_check.py\" --stop-hook",
            "timeout": 60,
            "statusMessage": "Checking executor-only source and review records..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/keep-going.py\"",
            "timeout": 120,
            "statusMessage": "Checking whether autonomous work remains..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent-routing/agent_routing_cli.py\" stop-hook",
            "timeout": 600,
            "statusMessage": "agent-routing: checking tests and the review gate for routed changes..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/ai-native/hooks/ai-native-stop.py\"",
            "timeout": 360,
            "statusMessage": "ai-native: end-state verification (only when AI_NATIVE_STOP_ENABLED=1)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-source-writes.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_worktree.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-review-before-merge.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-contract-writes.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/ai-native/scripts/pre_tool_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "AI_NATIVE_STOP_ENABLED": "1",
    "AI_NATIVE_CONTRACT_PATH": "tools/ai-native/contracts/session-default.json",
    "AI_NATIVE_REVIEWER_CMD": "python3 tools/ai-native/scripts/routing_reviewer.py"
  }
}
