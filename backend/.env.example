# Default realtime provider is Qwen Flash. GPT-Live, Baidu, and Fake remain optional.
VOICE_PROVIDER=qwen
QWEN_MODEL=qwen-audio-3.0-realtime-flash
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
QWEN_REALTIME_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime

# Optional Baidu adapter. Missing Baidu keys must not block Qwen or Fake.
# VOICE_PROVIDER=baidu
BAIDU_APP_ID=YOUR_APP_ID
BAIDU_API_KEY=YOUR_API_KEY
BAIDU_SECRET_KEY=YOUR_SECRET_KEY
BAIDU_E2E_MODEL=audio-mini-realtime-near
BAIDU_E2E_WS_URL=wss://aip.baidubce.com/ws/2.0/speech/v1/realtime

# Optional. Missing OPENAI_API_KEY must not block Qwen, Baidu, or Fake.
GPT_LIVE_MODEL=gpt-live-1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GPT_LIVE_WS_URL=wss://api.openai.com/v1/live/sessions

# fake/mock run without credentials.
# VOICE_PROVIDER=fake

# Opt-in live tests only. Leave unset or false for normal pytest.
# RUN_BAIDU_LIVE_TESTS=false
# RUN_QWEN_LIVE_TESTS=false
# RUN_GPT_LIVE_TESTS=false
